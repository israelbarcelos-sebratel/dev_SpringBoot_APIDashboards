# Modelo de variáveis para o docker-compose das APIs Java.
# Copie para `.env` (que é ignorado pelo git) e preencha os valores reais.
#   cp .env.example .env

# Banco de dados (MariaDB)
DB_HOST=10.0.11.171
DB_PORT=3306
DB_NAME=API_WebDeveloper
DB_USER=DevSebratel
DB_PASSWORD=

# Usuário com permissão de escrita (INSERT/UPDATE) usado só para atualizar o cache
# agg_tempos_atendente (ver sql/agg_tempos_atendente.sql e TemposAtendenteRefreshJob).
# Sem isso, cai no DB_USER acima — que hoje é só leitura, então o cache nunca é escrito.
CACHE_DB_USER=
CACHE_DB_PASSWORD=

# Nomes de atendente (exatamente como aparecem no sistema) com papel de administrador
# na extensão de Chrome TMA/TME. Separados por vírgula. Vazio = ninguém é admin.
ADMIN_USERS=

# Origens permitidas para CORS (BFF). Opcional — há defaults no compose.
MATRIX_BFF_ORIGIN=http://localhost:4001
NATIVE_BFF_ORIGIN=http://localhost:4002
