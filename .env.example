# Modelo de variáveis para o docker-compose das APIs Java.
# Copie para `.env` (que é ignorado pelo git) e preencha os valores reais.
#   cp .env.example .env

# Banco de dados (MariaDB)
DB_HOST=10.0.11.171
DB_PORT=3306
DB_NAME=API_WebDeveloper
DB_USER=DevSebratel
DB_PASSWORD=

# Banco próprio da aplicação (serviço app-db do compose): usuários da extensão e cache de tempos.
# Só a senha é obrigatória; ela é aplicada quando o volume é criado pela primeira vez.
APP_DB_PASSWORD=
# APP_DB_NAME=sebratel_app
# APP_DB_USER=sebratel_app

# E-mails @sebratel.com.br que são sempre administradores na extensão de Chrome (bootstrap).
# Separados por vírgula. Os demais papéis ficam na tabela usuarios_extensao.
ADMIN_EMAILS=

# Origens permitidas para CORS (BFF). Opcional — há defaults no compose.
MATRIX_BFF_ORIGIN=http://localhost:4001
NATIVE_BFF_ORIGIN=http://localhost:4002
