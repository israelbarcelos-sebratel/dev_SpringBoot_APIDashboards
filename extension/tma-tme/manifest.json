{
  "manifest_version": 3,
  "name": "Sebratel - TMA/TME Atendimento",
  "version": "0.9.0",
  "description": "Widget flutuante com TMA e TME por atendente (Native e Matrix), com login Google e papéis de usuário comum e administrador.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "oauth2": {
    "client_id": "243355917213-oa2b664bbmlskjkb9losafj6a8rsbtb2.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TMA/TME Sebratel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*/*.pdf"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "widget.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
